# ZeitFlow – Umgebungsvariablen (Beispiel). Secrets nie ins Repository committen.

# --- Pflicht ---------------------------------------------------------------
# Telegram-Bot-Token von @BotFather
ZEITFLOW_BOT_TOKEN=""

# Telegram-IDs der Büro-Admins (kommagetrennt). Ohne Angabe wird der erste Nutzer Admin.
# Eigene ID z. B. über @userinfobot ermitteln.
ZEITFLOW_ADMIN_IDS=""

# SQLite-Datei auf einem persistenten Volume
ZEITFLOW_DB_PATH="/data/zeitflow.db"

# --- Übersetzung (Claude API, ein zentraler Schlüssel) ----------------------
ANTHROPIC_API_KEY=""
# Optional, Standard: claude-opus-5-5
# ZEITFLOW_TRANSLATION_MODEL="claude-opus-5-5"

# --- Wöchentlicher Versand ---------------------------------------------------
ZEITFLOW_REPORT_EMAIL="abrechnung@example.org"
# 0 = Sonntag … 6 = Samstag; Uhrzeit in ZEITFLOW_TIMEZONE
ZEITFLOW_REPORT_WEEKDAY="0"
ZEITFLOW_REPORT_TIME="19:00"
ZEITFLOW_TIMEZONE="Europe/Berlin"
# Erscheint als Absender-Zeile in der E-Mail
ZEITFLOW_COMPANY_NAME=""

# --- SMTP ----------------------------------------------------------------------
ZEITFLOW_SMTP_HOST="smtp.example.org"
# starttls (Port 587) | ssl (Port 465) | none (Port 25)
ZEITFLOW_SMTP_SECURITY="starttls"
# ZEITFLOW_SMTP_PORT="587"
ZEITFLOW_SMTP_USER="zeitflow@example.org"
ZEITFLOW_SMTP_PASSWORD=""
ZEITFLOW_SMTP_FROM="zeitflow@example.org"
